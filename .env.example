# 应用配置
APP_NAME=Meta Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=9093

# 数据库配置 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/meta_service.db
DATABASE_ECHO=False

# user-service 对接（JWT 消费方）
# user-service 的基础 URL，用于拉取 JWKS 公钥（Docker 网络内用服务名，本地用 localhost）
USER_SERVICE_URL=http://localhost:8000
# JWKS 缓存 TTL（秒），到期后强制从 user-service 刷新；kid 未命中时也会立即刷新
JWKS_CACHE_TTL_SECONDS=3600
# JWT 签名算法（与 user-service 一致）
ALGORITHM=RS256

# 超级用户白名单（三重 AND 校验，缺一不可）：
# 1. JWT payload 的 role == "superuser"；
# 2. username（sub）在 SUPERUSER_USERNAMES 中；
# 3. user_id 在 SUPERUSER_USER_IDS 中。
# 无兜底：任意一项不满足即拒绝管理接口（403）。
# 部署时请将 user_id 改为 user-service 中实际 superuser 的 ID。
SUPERUSER_USERNAMES=["superuser"]
SUPERUSER_USER_IDS=[1]

# 元数据限额
# 单条 entry 的 data 最大字段数
MAX_ENTRY_DATA_KEYS=100
# data 嵌套最大深度（防深递归 / ReDoS）
MAX_ENTRY_DATA_DEPTH=5
# 单条 entry 最多 tags 数
MAX_TAGS_PER_ENTRY=20
# 单个 tag 最大长度
MAX_TAG_LENGTH=50
# 保留历史版本上限（超过则清理最旧版本）
MAX_VERSION_KEPT=50
# entity_key 最大长度
ENTRY_KEY_MAX_LENGTH=255

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/meta_service.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:9093"]

# 日志操作类型（LogProxy 拦截的方法名白名单）
LOG_OPERATIONS=["create","update","delete","soft_delete","restore","hard_delete","rollback","create_version"]
